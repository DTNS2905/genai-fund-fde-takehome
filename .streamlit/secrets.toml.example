# Copy to .streamlit/secrets.toml and fill in. Never commit secrets.toml.

# Free rehearsal with fictional accounts (no X keys needed, nothing sent). Delete this line to go live.
X_MOCK = "1"

# X developer app (developer.x.com) -> User authentication settings:
#   OAuth 2.0, type "Web App", callback URL must equal X_REDIRECT_URI exactly.
X_CLIENT_ID = ""
X_CLIENT_SECRET = ""          # leave empty if your app is a public ("Native App") client
X_REDIRECT_URI = "http://127.0.0.1:8501/"

# LLM via LiteLLM: switch provider by changing LLM_MODEL only ("<provider>/<model>").
# Leave LLM_MODEL empty to use the rule-based fallback (no LLM).
#   Gemini (free tier):  LLM_MODEL = "gemini/<model, e.g. a Flash model>"   + GEMINI_API_KEY (aistudio.google.com)
#   Ollama (local):      LLM_MODEL = "ollama/qwen3"                         (no key)
#   DeepSeek:            LLM_MODEL = "deepseek/deepseek-chat"               + DEEPSEEK_API_KEY
#   Anthropic:           LLM_MODEL = "anthropic/claude-haiku-5-5"           + ANTHROPIC_API_KEY
#   OpenAI:              LLM_MODEL = "openai/<model>"                       + OPENAI_API_KEY
#   vLLM server:         LLM_MODEL = "hosted_vllm/<model>"  + LLM_BASE_URL = "http://<host>:8000/v1"
LLM_MODEL = ""
GEMINI_API_KEY = ""
LLM_BASE_URL = ""   # only for self-hosted servers (vLLM etc.)

# Optional hard cap on estimated X API spend (USD). Calls are refused above it.
X_BUDGET_USD = ""

# Who you are and why you reach out (1-2 sentences). Used in every draft; edit per campaign.
SENDER_CONTEXT = "I'm with GenAI Fund. We build AI ecosystems in Southeast Asia."

# Optional demo safety: deliver EVERY message to this account (yours) instead of the real person.
TEST_RECIPIENT = ""
